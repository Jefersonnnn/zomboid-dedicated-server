# Copy to .env (or paste into Dokploy > Environment) and adjust.

# --- Required -------------------------------------------------------------
# Admin account created on the first start (used in-game and for /commands).
ADMIN_PASSWORD=troque-esta-senha

# --- Server identity / startup (always applied) ---------------------------
# Internal name: defines <SERVER_NAME>.ini and the save folder.
# Changing it later starts a NEW world.
SERVER_NAME=ZomboidServer
ADMIN_USERNAME=admin
# JVM heap. Keep PZ_MEM_LIMIT >= MAX_RAM + ~1.5 GB.
MAX_RAM=4g
# Container memory limit (whole JVM + native memory).
PZ_MEM_LIMIT=6g
# CPU cap (cores) and scheduling weight (default 1024). Keep below the host's
# core count so the Dokploy panel and other apps stay responsive.
PZ_CPUS=1.5
PZ_CPU_SHARES=512
# Garbage collector: G1GC (default, heap grows on demand) or ZGC (game
# default; reserves the whole heap up front - needs more memory headroom).
JVM_GC=G1GC

# --- Host folders ----------------------------------------------------------
# Changing these on a running server points it at EMPTY folders (new world).
# PZ_SERVER_DIR=/srv/zomboid/server
# PZ_DATA_DIR=/srv/zomboid/data

# --- Updates --------------------------------------------------------------
# Steam branch. "public" = current stable (Build 42 since 2026-07-29).
GAME_VERSION=public
# false = never update on restart. Set true, redeploy/restart, then back
# to false (after a backup!) to update the game.
UPDATE_ON_START=false

# --- .ini overrides --------------------------------------------------------
# Applied on every start ONLY if defined. Comment a line out to manage that
# setting directly in /srv/zomboid/data/Server/<SERVER_NAME>.ini instead.
SERVER_DISPLAY_NAME=Zomboid BR
SERVER_PASSWORD=senha-dos-jogadores
MAX_PLAYERS=4
# Open=true: anyone with the password can join (false = whitelist only).
PUBLIC_SERVER=true
# Public=false: do not list in the public server browser.
LIST_IN_BROWSER=false
PAUSE_ON_EMPTY=true
AUTOSAVE_INTERVAL=15
# Mods (Build 42 format). Use single quotes so the backslashes survive.
#  - MOD_WORKSHOP_IDS: Workshop numbers to download, separated by ";".
#  - MOD_NAMES: the "id=" from each mod.info, EACH prefixed with "\",
#    libraries/dependencies first. Without the "\" (Build 41 style) the
#    game silently loads nothing.
# MOD_WORKSHOP_IDS='3171167894;2846036306'
# MOD_NAMES='\damnlib;\92nissanGTR'
# MAP_NAMES=

# --- Control panel (service "panel") ---------------------------------------
# RCON password shared by the game server and the panel. Without it the
# game's RCON stays off and the panel cannot send commands. Use a long random
# value (e.g. `openssl rand -hex 24`); port 27015 is never published.
RCON_PASSWORD=troque-esta-senha-rcon
# Public HTTPS address of the panel (the domain added in Dokploy to the
# "panel" service, port 3001). Required: the panel rejects other origins.
PANEL_URL=https://painel.exemplo.com.br
# Group that owns /var/run/docker.sock on the host: `stat -c '%g' /var/run/docker.sock`
DOCKER_GID=999
# Panel image version (github.com/fpsacha/zomboid-control-panel/releases).
# PANEL_VERSION=2026.11.1
# PANEL_MEM_LIMIT=768m
# PANEL_CPUS=0.5
# false = the panel cannot start/stop the container (also remove the
# docker.sock line from docker-compose.yaml).
# PANEL_DOCKER_CONTROL_ENABLED=true
# RCON_PORT=27015

# --- Advanced (defaults are usually right) --------------------------------
# DEFAULT_PORT=16261
# UDP_PORT=16262
# FIRST_RUN_TIMEOUT=900
# SHUTDOWN_TIMEOUT=90
