# Copy to .env (or paste into Dokploy > Environment) and adjust.

# --- Required -------------------------------------------------------------
# Admin account created on the first start (used in-game and for /commands).
ADMIN_PASSWORD=troque-esta-senha

# --- Server identity / startup (always applied) ---------------------------
# Internal name: defines <SERVER_NAME>.ini and the save folder.
# Changing it later starts a NEW world.
SERVER_NAME=ZomboidServer
ADMIN_USERNAME=admin
# JVM heap. Keep PZ_MEM_LIMIT >= MAX_RAM + ~1.5 GB.
MAX_RAM=4g
# Container memory limit (whole JVM + native memory).
PZ_MEM_LIMIT=6g
# CPU cap (cores) and scheduling weight (default 1024). Keep below the host's
# core count so the Dokploy panel and other apps stay responsive.
PZ_CPUS=1.5
PZ_CPU_SHARES=512
# Garbage collector: G1GC (default, heap grows on demand) or ZGC (game
# default; reserves the whole heap up front - needs more memory headroom).
JVM_GC=G1GC

# --- Updates --------------------------------------------------------------
# Steam branch. "public" = current stable (Build 42 since 2026-07-29).
GAME_VERSION=public
# false = never update on restart. Set true, redeploy/restart, then back
# to false (after a backup!) to update the game.
UPDATE_ON_START=false

# --- .ini overrides --------------------------------------------------------
# Applied on every start ONLY if defined. Comment a line out to manage that
# setting directly in /srv/zomboid/data/Server/<SERVER_NAME>.ini instead.
SERVER_DISPLAY_NAME=Zomboid BR
SERVER_PASSWORD=senha-dos-jogadores
MAX_PLAYERS=4
# Open=true: anyone with the password can join (false = whitelist only).
PUBLIC_SERVER=true
# Public=false: do not list in the public server browser.
LIST_IN_BROWSER=false
PAUSE_ON_EMPTY=true
AUTOSAVE_INTERVAL=15
# MOD_NAMES=
# MOD_WORKSHOP_IDS=
# MAP_NAMES=

# --- Advanced (defaults are usually right) --------------------------------
# DEFAULT_PORT=16261
# UDP_PORT=16262
# FIRST_RUN_TIMEOUT=900
# SHUTDOWN_TIMEOUT=90
