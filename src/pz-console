#!/usr/bin/env bash
#
#  Send a command to the running Project Zomboid server console.
#  Usage (from the host):
#    docker exec <container> pz-console save
#    docker exec <container> pz-console 'servermsg "Restart in 5 minutes"'
#  Output appears in the container logs.
#

set -euo pipefail

readonly CONSOLE_FIFO="${PZ_CONSOLE_FIFO:-/home/steam/.run/console.fifo}"

if [[ $# -eq 0 ]]; then
    echo "Usage: pz-console <command...>" >&2
    exit 1
fi

if [[ ! -p "$CONSOLE_FIFO" ]]; then
    echo "Server console is not available (is the server running?)." >&2
    exit 1
fi

printf '%s\n' "$*" > "$CONSOLE_FIFO"
echo "Sent: $*"
